public class Main {
    public static void main(String[] args) {
        int[] numbers = {5, -3, 8, -1, 12, -7, 4};

        for (int i = 0; i < numbers.length; i++) {
            if (numbers[i] >= 0) {
                System.out.print(numbers[i] + " ");
            }
        }
        System.out.println();
    }
}
