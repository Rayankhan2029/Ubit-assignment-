import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int sum = 0;

        while (true) {
            System.out.println("Enter a number (0 to stop):");
            int input = scan.nextInt();

            if (input == 0) {
                break;
            }

            sum += input;
        }

        System.out.println("Sum = " + sum);
    }
}
